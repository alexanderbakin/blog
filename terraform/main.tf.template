terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  # Remote state backend
  #
  # S3 bucket stores the .tfstate file. Concurrency control is handled
  # at the CI/CD level (GitHub Actions `concurrency` key), so DynamoDB
  # locking is omitted — it's unnecessary complexity when only the
  # pipeline ever runs `apply`.
  #
  # If you ever run `apply` from multiple places (local + CI/CD,
  # multiple pipelines, etc.), add a DynamoDB lock table:
  #   aws dynamodb create-table \
  #     --table-name blog-terraform-locks \
  #     --attribute-definitions AttributeName=LockID,AttributeType=S \
  #     --key-schema AttributeName=LockID,KeyType=HASH \
  #     --billing-mode PAY_PER_REQUEST
  #
  # Then uncomment `dynamodb_table` below.
  backend "s3" {
    bucket  = "blog-terraform-state-ACCOUNTID-us-east-1-an"
    key     = "prod/terraform.tfstate"
    region  = "us-east-1"
    encrypt = true
    # dynamodb_table = "blog-terraform-locks"
  }
}
